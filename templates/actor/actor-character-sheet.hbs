<form class="{{cssClass}} {{actor.type}} flexcol" autocomplete="off">

  {{!-- Sheet Header --}}
  <header class="sheet-header">
    <div class="flex-fullwidth grid grid-3col">
      <img class="main-logo" src="/systems/subversion/assets/subversion_logo.png" title="subversion-logo" height="50" width="200"/>
      <div class="charname">
        <label for="name" class="resource-label">Name</label>
        <input name="name" type="text" value="{{actor.name}}" placeholder="Name"/>
      </div>
    </div>
    
    <div id="header-main" class="flex-fullwidth header-fields grid">
      <div id="header-left-values" class="flexcol" style="flex-grow: 0.5">
        <div>
          <label for="system.pronouns" class="resource-label">Pronouns</label>
          <input type="text", name="system.pronouns" value="{{system.pronouns}}" data-dtype="String"/>
        </div>
        <div>
          <label for="system.lineage" class="resource-label">Lineage</label>
          <input type="text", name="system.lineage" value="{{system.lineage}}" data-dtype="String"/>
        </div>
        <div>
          <label for="system.origin" class="resource-label">Origin</label>
          <input type="text", name="system.origin" value="{{system.origin}}" data-dtype="String"/>
        </div>
        <div>
          <label for="system.caste" class="resource-label">Caste</label>
          <input type="text", name="system.pronouns" value="{{system.caste}}" data-dtype="String"/>
        </div>
        <div>
          <label for="system.debt" class="resource-label">Debt</label>
          <input type="text", name="system.debt" value="{{system.debt}}" data-dtype="String"/>
        </div>
      </div>

      <div id="header-center-values" class="flexrow">
        <div class="attribute-values flexcol" style="flex-grow: 0.5">
          <div>
            <label for="system.abilities.agi.value" class="resource-label">Agility</label>
            <input type="text", name="system.abilities.agi.value" value="{{system.abilities.agi.value}}" data-dtype="Number"/>
          </div>
          <div>
            <label for="system.abilities.wit.value" class="resource-label">Wit</label>
            <input type="text", name="system.abilities.wit.value" value="{{system.abilities.wit.value}}" data-dtype="Number"/>
          </div>
                    <div>
            <label for="system.abilities.awr.value" class="resource-label">Awareness</label>
            <input type="text", name="system.abilities.awr.value" value="{{system.abilities.awr.value}}" data-dtype="Number"/>
          </div>
        </div>

        <img id="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" height="200"/>

        <div class="attribute-values flexcol" style="flex-grow: 0.5">
          <div>
            <label for="system.abilities.bwn.value" class="resource-label">Brawn</label>
            <input type="text", name="system.abilities.bwn.value" value="{{system.abilities.bwn.value}}" data-dtype="Number"/>
          </div>
          <div>
            <label for="system.abilities.cha.value" class="resource-label">Charisma</label>
            <input type="text", name="system.abilities.cha.value" value="{{system.abilities.cha.value}}" data-dtype="Number"/>
          </div>
          <div>
            <label for="system.abilities.wil.value" class="resource-label">Will</label>
            <input type="text", name="system.abilities.wil.value" value="{{system.abilities.wil.value}}" data-dtype="Number"/>
          </div>
        </div>
      </div>

      <div id="header-right-values" class="flexcol" style="flex-grow: 0.5">
        <div>
          <label for="system.ideology" class="resource-label">Ideology</label>
          <input type="text", name="system.ideology" value="{{system.ideology}}" data-dtype="String"/>
        </div>
        <div>
          <label for="system.value1" class="resource-label">Value</label>
          <input type="text", name="system.value1" value="{{system.value1}}" data-dtype="String"/>
        </div>
        <div>
          <label for="system.value2" class="resource-label">Value</label>
          <input type="text", name="system.value2" value="{{system.value2}}" data-dtype="String"/>
        </div>
        <div>
          <label for="system.value3" class="resource-label">Value</label>
          <input type="text", name="system.value3" value="{{system.value3}}" data-dtype="String"/>
        </div>
      </div>
    </div>
    <div id="header-foot" class="grid-2col header-fields">
      <div id="header-defense">
        <div class="area-label">Defense</div>
        <div class="flexrow">
          <div>
            <label for="system.guard.value" class="resource-label">Guard</label>
            <input type="text", name="system.guard.value" value="{{system.guard.value}}" data-dtype="Number"/>
          </div>
          <div>
            <label for="system.vigilance.value" class="resource-label">Vigilance</label>
            <input type="text", name="system.vigilance.value" value="{{system.vigilance.value}}" data-dtype="Number"/>
          </div>
          <div>
            <label for="system.aegis.value" class="resource-label">Aegis</label>
            <input type="text", name="system.aegis.value" value="{{system.aegis.value}}" data-dtype="Number"/>
          </div>
        </div>
        <div class="flexrow">
          <div>
            <label for="system.initiative.value" class="resource-label">Initiative</label>
            <input type="text", name="system.initiative.value" value="{{system.initiative.value}}" data-dtype="Number"/>
          </div>
          <div>
            <label for="system.armor.value" class="resource-label">Armor</label>
            <input type="text", name="system.armor.value" value="{{system.armor.value}}" data-dtype="Number"/>
          </div>
          <div>
            <label for="system.adamant.value" class="resource-label">Adamant</label>
            <input type="text", name="system.adamant.value" value="{{system.adamant.value}}" data-dtype="Number"/>
          </div>
        </div>
      </div>
      <div id="header-condition">

      </div>
    </div>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    {{!-- Default tab is specified in actor-sheet.mjs --}}
    <a class="item" data-tab="features">Features</a>
    <a class="item" data-tab="description">Description</a>
    <a class="item" data-tab="items">Items</a>
    <a class="item" data-tab="spells">Abilities</a>
    <a class="item" data-tab="effects">Effects</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Owned Features Tab --}}
    <div class="tab features" data-group="primary" data-tab="features">
      <section class="grid grid-3col">
        <aside class="sidebar">

          {{!-- The grid classes are defined in scss/global/_grid.scss. To use,
          use both the "grid" and "grid-Ncol" class where "N" can be any number
          from 1 to 12 and will create that number of columns.  --}}
          <div class="abilities flexcol">
            {{#each system.abilities as |ability key|}}
            <div class="ability flexrow flex-group-center">
              <label for="system.abilities.{{key}}.value" class="resource-label rollable flexlarge align-left" data-roll="d20+@abilities.{{key}}.mod" data-label="{{localize (lookup @root.config.abilities key)}}">{{localize (lookup @root.config.abilities key)}}</label>
              <input type="text" name="system.abilities.{{key}}.value" value="{{ability.value}}" data-dtype="Number"/>
              <span class="ability-mod rollable" data-roll="d20+@abilities.{{key}}.mod" data-label="{{localize (lookup @root.config.abilities key)}}">{{numberFormat ability.mod decimals=0 sign=true}}</span>
            </div>
            {{/each}}
          </div>
        </aside>

        {{!-- For the main features list, span the right two columns --}}
        <section class="main grid-span-2">
          {{!-- This is a Handlebars partial. They're stored in the `/parts` folder next to this sheet, and defined in module/helpers/templates.mjs --}}
          {{> "systems/subversion/templates/actor/parts/actor-features.hbs"}}
        </section>

      </section>
    </div>

    {{!-- Biography Tab --}}
    <div class="tab biography" data-group="primary" data-tab="description">
      {{!-- Editors must receive enriched text data from getData to properly handle rolls --}}
      {{editor enrichedBiography target="system.biography" engine="prosemirror" button=true editable=editable}}
    </div>

    {{!-- Owned Items Tab --}}
    <div class="tab items" data-group="primary" data-tab="items">
       {{> "systems/subversion/templates/actor/parts/actor-items.hbs"}}
    </div>

    {{!-- Owned Spells Tab --}}
    <div class="tab spells" data-group="primary" data-tab="spells">
      {{> "systems/subversion/templates/actor/parts/actor-spells.hbs"}}
    </div>

    {{!-- Active Effects Tab --}}
    <div class="tab effects flexcol" data-group="primary" data-tab="effects">
      {{> "systems/subversion/templates/actor/parts/actor-effects.hbs"}}
    </div>

  </section>
</form>
