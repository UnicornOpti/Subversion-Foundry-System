<form class="{{cssClass}} {{actor.type}} flexcol" autocomplete="off">

  {{!-- Sheet Header --}}
  <header class="sheet-header">
    <div id="logobar" class="flex-fullwidth grid grid-3col">
      <img class="main-logo" src="/systems/subversion/assets/subversion_logo.png" title="subversion-logo" height="50" width="200"/>
      <div id="charname">
        <label for="name" class="resource-label">Name</label>
        <input name="name" type="text" value="{{actor.name}}" placeholder="Name"/>
      </div>
    </div>
    
    <div id="header-main" class="flex-fullwidth header-fields grid">
      <div id="header-left-values" class="flexcol" style="flex-grow: 0.5">
        <div class="torn-background" style="background-color: rgba(157, 175, 186, 80);"></div>
        <div class="system-value">
          <label for="system.pronouns" class="resource-label">Pronouns</label>
          <input type="text", name="system.pronouns" value="{{system.pronouns}}" data-dtype="String"/>
        </div>
        <div class="system-value">
          <label for="system.lineage" class="resource-label">Lineage</label>
          <input type="text", name="system.lineage" value="{{system.lineage}}" data-dtype="String"/>
        </div>
        <div class="system-value">
          <label for="system.origin" class="resource-label">Origin</label>
          <input type="text", name="system.origin" value="{{system.origin}}" data-dtype="String"/>
        </div>
        <div class="system-value">
          <label for="system.caste" class="resource-label">Caste</label>
          <input type="text", name="system.caste" value="{{system.caste}}" data-dtype="String"/>
        </div>
        <div class="system-value">
          <label for="system.debt" class="resource-label">Debt</label>
          <input type="text", name="system.debt" value="{{system.debt}}" data-dtype="String"/>
        </div>
      </div>

      <div id="header-center-values" class="flexrow">
        <div class="attribute-values flexcol" style="flex-grow: 0.5">
          <div>
            <label for="system.abilities.agi.value" class="resource-label">Agility</label>
            <input type="text", name="system.abilities.agi.value" value="{{system.abilities.agi.value}}" data-dtype="Number"/>
          </div>
          <div>
            <label for="system.abilities.wit.value" class="resource-label">Wit</label>
            <input type="text", name="system.abilities.wit.value" value="{{system.abilities.wit.value}}" data-dtype="Number"/>
          </div>
                    <div>
            <label for="system.abilities.awr.value" class="resource-label">Awareness</label>
            <input type="text", name="system.abilities.awr.value" value="{{system.abilities.awr.value}}" data-dtype="Number"/>
          </div>
        </div>

        <img id="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" height="200"/>

        <div class="attribute-values flexcol" style="flex-grow: 0.5">
          <div>
            <label for="system.abilities.bwn.value" class="resource-label">Brawn</label>
            <input type="text", name="system.abilities.bwn.value" value="{{system.abilities.bwn.value}}" data-dtype="Number"/>
          </div>
          <div>
            <label for="system.abilities.cha.value" class="resource-label">Charisma</label>
            <input type="text", name="system.abilities.cha.value" value="{{system.abilities.cha.value}}" data-dtype="Number"/>
          </div>
          <div>
            <label for="system.abilities.wil.value" class="resource-label">Will</label>
            <input type="text", name="system.abilities.wil.value" value="{{system.abilities.wil.value}}" data-dtype="Number"/>
          </div>
        </div>
      </div>

      <div id="header-right-values" class="flexcol" style="flex-grow: 0.5">
        <div class="torn-background torn-left" style="background-color: rgba(157, 175, 186, 80);"></div>
        <div class="system-value">
          <label for="system.ideology" class="resource-label">Ideology</label>
          <input type="text", name="system.ideology" value="{{system.ideology}}" data-dtype="String"/>
        </div>
        <div class="system-value">
          <label for="system.value1" class="resource-label">Value</label>
          <input type="text", name="system.value1" value="{{system.value1}}" data-dtype="String"/>
        </div>
        <div class="system-value">
          <label for="system.value2" class="resource-label">Value</label>
          <input type="text", name="system.value2" value="{{system.value2}}" data-dtype="String"/>
        </div>
        <div class="system-value">
          <label for="system.value3" class="resource-label">Value</label>
          <input type="text", name="system.value3" value="{{system.value3}}" data-dtype="String"/>
        </div>
      </div>
    </div>
    <img id="header-separator" src="/systems/subversion/assets/decoration.webp" title="header-deco"/>
    <div id="header-foot" class="grid-2col header-fields">
      <div id="header-defense">
        <div class="area-label">Defense</div>
        <div class="flexrow">
          <div class="condition-tracker">
            <label for="system.guard" class="resource-label">Guard</label>
            <input type="text" name="system.guard" value="{{system.guard}}" data-dtype="Number"/>
          </div>
          <div class="condition-tracker">
            <label for="system.vigilance" class="resource-label">Vigilance</label>
            <input type="text" name="system.vigilance" value="{{system.vigilance}}" data-dtype="Number"/>
          </div>
          <div class="condition-tracker"> 
            <label for="system.aegis" class="resource-label">Aegis</label>
            <input type="text" name="system.aegis" value="{{system.aegis}}" data-dtype="Number"/>
          </div>
        </div>
        <div class="flexrow">
          <div class="condition-tracker">
            <label for="system.initiative" class="resource-label">Initiative</label>
            <input type="text" name="system.initiative" value="{{system.initiative}}" data-dtype="Number"/>
          </div>
          <div class="condition-tracker">
            <label for="system.armor" class="resource-label">Armor</label>
            <input type="text" name="system.armor" value="{{system.armor}}" data-dtype="Number"/>
          </div>
          <div class="condition-tracker">
            <label for="system.adamant" class="resource-label">Adamant</label>
            <input type="text" name="system.adamant" value="{{system.adamant}}" data-dtype="Number"/>
          </div>
        </div>
      </div>
      <div id="header-condition">
          <div class="area-label">Condition</div>
          <div class="flexrow">
            <div class="condition-tracker">
              <label for="system.health" class="resource-label">Health</label>
              <div class="flexrow">
                <input type="text" name="system.health.current" value="{{system.health.current}}" data-dtype="Number"/>
                <span> / </span>
                <input type="text" name="system.health.max" value="{{system.health.max}}" data-dtype="Number"/>
              </div>
            </div>
            <div class="condition-tracker">
              <label  for="system.animity" class="resource-label">Animity</label>
              <div class="flexrow">
                <input type="text" name="system.animity.current" value="{{system.animity.current}}" data-dtype="Number"/>
                <span> / </span>
                <input type="text" name="system.animity.max" value="{{system.animity.max}}" data-dtype="Number"/>
              </div>
            </div>
            <div class="condition-tracker">
              <label for="system.grit" class="resource-label">Grit</label>
              <div class="flexrow">
                <input type="text" name="system.grit.current" value="{{system.grit.current}}" data-dtype="Number"/>
                <span> / </span>
                <input type="text" name="system.grit.max" value="{{system.grit.max}}" data-dtype="Number"/>
              </div>
            </div>
          </div>
          <div id="consequence-banner" class="resource-label">Consequences</div>
          <div>
            <div id="consequence-holder" class="flexrow align-center">
              <input type="checkbox" id="consBox1" class="consBox" name="system.consequences.show.show1" value="1" data-dtype="Boolean" {{checked system.consequences.show.show1}}/>
              <input type="checkbox" id="consBox2" class="consBox" name="system.consequences.show.show2" value="2" data-dtype="Boolean" {{checked system.consequences.show.show2}}/>
              <input type="checkbox" id="consBox3" class="consBox" name="system.consequences.show.show3" value="3" data-dtype="Boolean" {{checked system.consequences.show.show3}}/>
              <input type="checkbox" id="consBox4" class="consBox" name="system.consequences.show.show4" value="4" data-dtype="Boolean" {{checked system.consequences.show.show4}}/>
              <input type="checkbox" id="consBox5" class="consBox" name="system.consequences.show.show5" value="5" data-dtype="Boolean" {{checked system.consequences.show.show5}}/>
              <input type="hidden" name="system.consequences.value" value="{{system.consequences.value}}" data-dtype="Number" />
            </div>        
            <label for="system.consequences" class="resource-label">+1 Instance of Dulled Each</label>
          </div>
      </div>
    </div>
  </header>
  <div id="tab-separator-line"></div>
  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    {{!-- Default tab is specified in actor-sheet.mjs --}}
    <a class="item" data-tab="main">Details</a>
    <a class="item" data-tab="description">Description</a>
    <a class="item" data-tab="items">Items</a>
    <a class="item" data-tab="features">Abilities</a>
    <a class="item" data-tab="effects">Effects</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Owned Features Tab --}}
    <div class="tab main" data-group="primary" data-tab="main">
      <section id="grid-details" >
        <div id="impulses">
          <div class="area-label">Impulses</div>
          <div class="impulse-input">
            <label for="system.impulses.names" class="resource-label">Names</label>
            <textarea type="text" name="system.impulses.names" data-dtype="String" >{{system.impulses.names}}</textarea>
          </div>
          <div class="impulse-input">
              <label for="system.impulses.triggers" class="resource-label">Triggers</label>
              <textarea name="system.impulses.triggers" data-dtype="String">{{system.impulses.triggers}}</textarea>
          </div>
          <div class="impulse-input">
              <label for="system.impulses.downtime" class="resource-label">Downtime</label>
              <textarea name="system.impulses.downtime" data-dtype="String">{{system.impulses.downtime}}</textarea>
          </div>
        </div>

        <div id="skills">
          <div class="area-label">Skills</div>
          {{> "systems/subversion/templates/actor/parts/actor-skills.hbs"}}
        </div>
        <!--
            <div class="abilities flexcol">
            {{#each system.abilities as |ability key|}}
            <div class="ability flexrow flex-group-center">
              <label for="system.abilities.{{key}}.value" class="resource-label rollable flexlarge align-left" data-roll="d20+@abilities.{{key}}.value" data-label="{{localize (lookup @root.config.abilities key)}}">{{localize (lookup @root.config.abilities key)}}</label>
              <input type="text" name="system.abilities.{{key}}.value" value="{{ability.value}}" data-dtype="Number"/>
              <span class="ability-mod rollable" data-roll="d20+@abilities.{{key}}.value" data-label="{{localize (lookup @root.config.abilities key)}}">{{numberFormat ability.value decimals=0 sign=true}}</span>
            </div>
            {{/each}}
          </div>
        </div>
          {{!-- The grid classes are defined in scss/global/_grid.scss. To use,
          use both the "grid" and "grid-Ncol" class where "N" can be any number
          from 1 to 12 and will create that number of columns.  --}}


        {{!-- For the main features list, span the right two columns --}}
        <section class="main grid-span-2">
          {{!-- This is a Handlebars partial. They're stored in the `/parts` folder next to this sheet, and defined in module/helpers/templates.mjs --}}
          {{> "systems/subversion/templates/actor/parts/actor-features.hbs"}}
        </section>
      -->
      </section>
    </div>

    {{!-- Biography Tab --}}
    <div class="tab biography" data-group="primary" data-tab="description">
      {{!-- Editors must receive enriched text data from getData to properly handle rolls --}}
      {{editor enrichedBiography content="system.biography" target="system.biography" engine="prosemirror" button=true editable=editable}}
    </div>

    {{!-- Owned Items Tab --}}
    <div class="tab items" data-group="primary" data-tab="items">
       {{> "systems/subversion/templates/actor/parts/actor-items.hbs"}}
    </div>

    {{!-- Owned Spells Tab --}}
    <div class="tab features" data-group="primary" data-tab="features">
      {{> "systems/subversion/templates/actor/parts/actor-features.hbs"}}
    </div>

    {{!-- Active Effects Tab --}}
    <div class="tab effects flexcol" data-group="primary" data-tab="effects">
      {{> "systems/subversion/templates/actor/parts/actor-effects.hbs"}}
    </div>

  </section>
</form>
