<ol class='items-list features-list'>
  <li class='item flexrow items-header features-header'>
    <div class='item-name feature-name'>{{localize 'Name'}}</div>
    <div>{{localize 'Uses'}}</div>
    <div class='item-formula'>{{localize 'Roll Formula'}}</div>
    <div class='item-controls feature-controls'>
      <a
        class='item-control feature-create'
        title='{{localize "DOCUMENT.Create" type='Feature'}}'
        data-type='feature'
      >
        <i class='fas fa-plus'></i>
        {{localize 'DOCUMENT.New' type='Feature'}}
      </a>
    </div>
  </li>
  {{#each feature as |feat id|}}
    <li class='item flexrow' data-item-id='{{feat._id}}'>
      <div class='item-name'>
        <div class='item-image'>
          <a class='rollable' data-roll-type='feature'>
            <img
              src='{{feat.img}}'
              title='{{feat.name}}'
              width='24'
              height='24'
            />
          </a>
        </div>
        <h4>{{item.name}}</h4>
      </div>
      <div class='item-prop'>{{feat.system.maxUses}}</div>
      <div class='item-prop'>{{feat.system.currentUses}}</div>
      <div class='item-formula item-prop'>{{feat.system.formula}}</div>
      <div class='item-controls'>
        <a
          class='item-control item-edit'
          title='{{localize "DOCUMENT.Update" type='Feature'}}'
        >
          <i class='fas fa-edit'></i>
        </a>
        <a
          class='item-control item-delete'
          title='{{localize "DOCUMENT.Delete" type='Feature'}}'
        >
          <i class='fas fa-trash'></i>
        </a>
      </div>
    </li>
  {{/each}}
</ol>