    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch localhost",
            "type": "firefox",
            "request": "launch",
            "reAttach": true,
            "profile": "default-release",
            "url": "http://localhost:30000",
            "webRoot": "${workspaceFolder}",
            "pathMappings": [
                {
                    "url": "http://localhost:30000/systems",
                    "path": "d:/Brandon/FoundryVTT/Data/systems"
                },
                {
                    "url": "http://localhost:30000/scripts",
                    "path": "c:/Program Files/Foundry Virtual Tabletop/resources/app/public/scripts"
                }
            ]
        },
        {
            "name": "Attach",
            "type": "firefox",
            "request": "attach"
        }
    ]
}